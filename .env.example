GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua_chave_api_aqui

# Forms nativo pela planilha de respostas ou CSV publicado
FORMS_CSV_URL=
FORMS_SHEET_ID=
FORMS_SHEET_ABA=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Cole somente o trecho entre /d/ e /edit do link da planilha.
# A conta de serviço precisa de acesso de editor.
LATENCIA_SHEETS_ID=
LATENCIA_SHEETS_ABA=latencia_agente
# Aba, na mesma planilha, com um ticket por reclamação encerrada
TICKETS_SHEETS_ABA=tickets_atendimento

# Alternativa sem Google Cloud: Apps Script da planilha (docs/apps_script_sheets.gs).
# Com a URL preenchida, ela é usada no lugar da conta de serviço.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Databricks Gold: única fonte de pedidos (sem reserva em CSV ou amostra)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_TABELA_GOLD_PEDIDOS=

# Preencher somente com uma campanha aprovada pela equipe

# Modelos Gemini (Google), do principal às reservas, separados por vírgula.
# Se o principal demorar, o próximo entra em paralelo (MODELO_HEDGE_SEGUNDOS; 0 desliga).
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
MODELO_HEDGE_SEGUNDOS=3
# Se todos os modelos falharem, a cadeia recomeça até algum responder, por no máximo
# este tempo (segundos; 0 = sem limite). Depois disso o cliente recebe a mensagem segura.
MODELO_INSISTENCIA_SEGUNDOS=300

# Link público do Google Forms enviado ao cliente que quer reclamar
FORMS_URL=
# Quanto o agente espera o envio do formulário (segundos) e de quanto em quanto tempo confere
FORMS_ESPERA_SEGUNDOS=900
FORMS_INTERVALO_SEGUNDOS=3
