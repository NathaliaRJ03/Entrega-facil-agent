GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua_chave_api_aqui

# Forms nativo pela planilha de respostas ou CSV publicado
FORMS_CSV_URL=
FORMS_SHEET_ID=
FORMS_SHEET_ABA=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Cole somente o trecho entre /d/ e /edit do link da planilha.
# A conta de serviço precisa de acesso de editor.
LATENCIA_SHEETS_ID=
LATENCIA_SHEETS_ABA=latencia_agente
# Aba, na mesma planilha, com um ticket por reclamação encerrada
TICKETS_SHEETS_ABA=tickets_atendimento

# Alternativa sem Google Cloud: Apps Script da planilha (docs/apps_script_sheets.gs).
# Com a URL preenchida, ela é usada no lugar da conta de serviço.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# Databricks Gold (vazio = usa data/entrada/gold_pedidos.csv ou amostra)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_TABELA_GOLD_PEDIDOS=

# Preencher somente com uma campanha aprovada pela equipe

# Modelo Gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelos de reserva, nesta ordem (deixe vazio para desativar cada reserva)
# 1. Outro Gemini, com cota própria
GEMINI_MODEL_RESERVA=gemini-3.5-flash

# 2. OpenAI, outro provedor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

